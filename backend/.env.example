ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/hetu?sslmode=require

# Clerk: the PEM JWT key enables networkless verification.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
CLERK_WEBHOOK_SECRET=whsec_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://app.example.com

CORS_ORIGINS=http://localhost:5173,https://app.example.com
TRUSTED_HOSTS=localhost,127.0.0.1,api.example.com,hetu-api.onrender.com

UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=hetu
# Optional public bucket/custom-domain URL. Leave empty for signed downloads.
R2_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=26214400

SENTRY_DSN=
