# Client-safe React configuration. All durable application data is online.
VITE_BACKEND=fastapi
VITE_API_URL=/api
VITE_CLERK_PROXY_URL=/__clerk
VITE_CLERK_PUBLISHABLE_KEY=

# Optional client-safe values. Backend secrets belong only in backends/python.
VITE_SENTRY_DSN=
VITE_APP_URL=https://hetu-app.vercel.app
# Telegram and push delivery remain unavailable until Python workers are configured.
VITE_TELEGRAM_BOT_USERNAME=
VITE_WEB_PUSH_PUBLIC_KEY=
